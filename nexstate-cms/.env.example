# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...). Server-only. PASTE HERE:
SUPABASE_SERVICE_ROLE_KEY=

# --- Better Auth connects straight to Postgres (Project Settings > Database > Connection string) ---
# Use the Session pooler string, e.g. postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# PASTE HERE:
DATABASE_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Required to claim the first admin account on /admin/setup
ADMIN_SETUP_TOKEN=

# Optional: AI features (Gemini), invite emails (Resend)
GEMINI_API_KEY=
RESEND_API_KEY=

# --- Payments: Razorpay (https://dashboard.razorpay.com > Account & Settings > API Keys) ---
# Use TEST keys (rzp_test_...) until you are ready for real money.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Account & Settings > Webhooks: add https://<your-cms-domain>/api/payments/webhook,
# subscribe to payment.captured, order.paid and payment.failed, and paste the secret you choose here.
RAZORPAY_WEBHOOK_SECRET=